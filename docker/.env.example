# Copy to docker/.env and choose credentials before first startup.
# Match these values in docker/docker_config.yaml.
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP_PASSWORD
MINIO_ROOT_USER=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET_KEY

# Optional master switch for both Jev integrations: disabled / observe / enforce.
# Empty keeps the mode in the backend YAML. Recreate backend after changing it.
JEV_MODE=
